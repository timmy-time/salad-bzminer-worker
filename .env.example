# Copy to .env and edit. All values are optional; the image supplies defaults.
# See config/defaults.env and docs/CONFIGURATION.md.

MINING_ALGORITHM=pearl
MINING_POOL=stratum+tcp://pearl-au.luckypool.io:3360
# Optional comma-free single backup URL. BzMiner rotates to it after a disconnect.
MINING_POOL_FALLBACK=
MINING_WALLET=prl1px0drjsz2a9ynqc575ndcf0u7t89tkwqjefvm2v4v9yqhw8h74v6sk2fc90

# Generated when empty: <prefix>-<gpu>-<8hex>.
WORKER_PREFIX=salad
WORKER_NAME=

GPU_ONLY=true
CPU_MINING=false

# Native Nockchain base58 address (never a 0x wrapped-token address).
NOCK_WALLET=

# Shell-like tokens, no shell: quotes and backslashes are honored. Managed
# flags (wallet/pool/algorithm/CPU/HTTP/device selection) are rejected.
MINER_EXTRA_ARGS=
LOG_LEVEL=info

HEALTH_ENABLED=true
HEALTH_PORT=8080
HEALTH_BIND=0.0.0.0

# Internal only. Do not publish this port: BzMiner's control API has no auth.
MINER_HTTP_PORT=4014
BZMINER_BIN=/opt/bzminer/bzminer
# Optional explicit nvidia-smi; otherwise the worker uses bzminer --gpu-info.
NVIDIA_SMI_PATH=

RESTART_BACKOFF_BASE_SECONDS=2
RESTART_BACKOFF_MAX_SECONDS=300
STARTUP_TIMEOUT_SECONDS=180
SHUTDOWN_GRACE_SECONDS=20
