# BzMiner worker defaults. Process environment overrides these values.
# A variable set to an empty string in the environment remains empty.

MINING_ALGORITHM=pearl
MINING_POOL=stratum+tcp://pearl-au.luckypool.io:3360
MINING_WALLET=prl1px0drjsz2a9ynqc575ndcf0u7t89tkwqjefvm2v4v9yqhw8h74v6sk2fc90
# Optional secondary pool: BzMiner rotates to it after a disconnect.
MINING_POOL_FALLBACK=
WORKER_PREFIX=salad
WORKER_NAME=
GPU_ONLY=true
CPU_MINING=false
NOCK_WALLET=
MINER_EXTRA_ARGS=
LOG_LEVEL=info

HEALTH_ENABLED=true
HEALTH_PORT=8080
HEALTH_BIND=0.0.0.0

MINER_HTTP_PORT=4014
BZMINER_BIN=/opt/bzminer/bzminer
# Optional: override GPU detection with a specific nvidia-smi path.
NVIDIA_SMI_PATH=
RESTART_BACKOFF_BASE_SECONDS=2
RESTART_BACKOFF_MAX_SECONDS=300
STARTUP_TIMEOUT_SECONDS=180
SHUTDOWN_GRACE_SECONDS=20
